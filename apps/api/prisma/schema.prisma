generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum LeadTemperature {
  HOT
  WARM
  COLD
}

enum LeadQualification {
  UNASSESSED
  STRONG_FIT
  GOOD_FIT
  WEAK_FIT
  UNQUALIFIED
}

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum FollowUpChannel {
  EMAIL
  CALL
  WHATSAPP
  LINKEDIN
  OTHER
}

model User {
  id String @id @default(uuid())

  email        String @unique
  passwordHash String

  firstName String?
  lastName  String?
  avatarUrl String?

  emailVerified Boolean @default(false)

  memberships OrganizationMember[]
  sessions    Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Organization {
  id String @id @default(uuid())

  name String
  slug String @unique

  website  String?
  industry String?

  members   OrganizationMember[]
  sessions  Session[]
  leads     Lead[]
  contacts  Contact[]
  proposals Proposal[]
  followUps FollowUp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}

model OrganizationMember {
  id String @id @default(uuid())

  organizationId String
  userId         String

  role OrganizationRole @default(MEMBER)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

model Session {
  id String @id @default(uuid())

  userId         String
  organizationId String

  refreshTokenHash String

  expiresAt DateTime
  revokedAt DateTime?

  userAgent String?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@index([expiresAt])
  @@map("sessions")
}

model Contact {
  id String @id @default(uuid())

  organizationId String
  identityKey    String

  firstName String
  lastName  String?

  email String?
  phone String?

  company  String?
  jobTitle String?
  website  String?

  source String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]
  proposals    Proposal[]
  followUps    FollowUp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, identityKey])
  @@index([organizationId])
  @@index([organizationId, email])
  @@index([organizationId, phone])
  @@index([organizationId, company])
  @@index([organizationId, updatedAt])
  @@map("contacts")
}

model Lead {
  id String @id @default(uuid())

  organizationId String
  contactId      String?

  firstName String
  lastName  String?

  email String?
  phone String?

  company  String?
  jobTitle String?
  website  String?

  source String?

  stage LeadStage @default(NEW)

  temperature LeadTemperature?

  qualification LeadQualification @default(UNASSESSED)

  valueCents Int?

  currency String @default("EUR")

  notes String?

  lastActivityAt  DateTime?
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?

  aiSummary String?

  aiNextBestAction String?

  aiInformationConfidence Int?

  aiRisks              String[] @default([])
  aiMissingInformation String[] @default([])

  aiUpdatedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  proposals    Proposal[]
  followUps    FollowUp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * Existing organization-scoped indexes remain useful.
   * The composite indexes below directly match the hottest
   * list/pipeline ordering patterns.
   */
  @@index([organizationId])
  @@index([organizationId, contactId])
  @@index([organizationId, stage, updatedAt])
  @@index([organizationId, stage, valueCents])
  @@index([organizationId, temperature])
  @@index([organizationId, qualification])
  @@index([organizationId, email])
  @@index([organizationId, nextFollowUpAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, updatedAt])
  @@index([organizationId, company])
  @@map("leads")
}

model Proposal {
  id String @id @default(uuid())

  organizationId String
  leadId         String
  contactId      String?

  title String

  status ProposalStatus @default(DRAFT)

  amountCents Int
  currency    String @default("EUR")

  summary  String?
  scope    String?
  timeline String?
  terms    String?

  validUntil DateTime?

  sentAt     DateTime?
  viewedAt   DateTime?
  acceptedAt DateTime?
  rejectedAt DateTime?

  viewCount Int @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, leadId])
  @@index([organizationId, contactId])
  @@index([organizationId, createdAt])
  @@map("proposals")
}

model FollowUp {
  id String @id @default(uuid())

  organizationId String
  leadId         String
  contactId      String?

  channel FollowUpChannel @default(EMAIL)
  status  FollowUpStatus  @default(PENDING)

  scheduledFor DateTime

  subject      String?
  draftMessage String?
  reason       String?

  completedAt DateTime?
  cancelledAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, status, scheduledFor])
  @@index([organizationId, leadId])
  @@index([organizationId, contactId])
  @@index([organizationId, createdAt])
  @@map("follow_ups")
}
